# the source plus first-touch UTM / referrer_host / landing_path to the Resend
# email body only. No new external calls, no worker hook, not applied to main.
# Base: main bf85cba767e3f27f2e1201a724a0080aff073db4
#
diff --git a/app/api/contact/route.ts b/app/api/contact/route.ts
index 2cf2ec3..d1bb90b 100644
--- a/app/api/contact/route.ts
+++ b/app/api/contact/route.ts
@@ -1,4 +1,12 @@
-import { inquiryEmail, inquiryLimits, projectPhases } from "@/lib/project-inquiry";
+import {
+  attributionFields,
+  inquiryEmail,
+  inquiryLimits,
+  leadSourceValues,
+  leadSources,
+  projectPhases,
+  sanitizeAttribution,
+} from "@/lib/project-inquiry";
 
 const maxBodyBytes = 12_288;
 
@@ -46,8 +54,8 @@ export async function POST(request: Request) {
     return Response.json({ error: "Refresh the inquiry page and try again." }, { status: 400 });
   }
 
