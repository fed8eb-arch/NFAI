+  const values = { name: "", company: "", email: "", location: "", phase: "", message: "", how_did_you_hear_about_us: "" };
+  const errors: Partial<Record<keyof typeof values | "how_did_you_hear_about_us_other", string>> = {};
   for (const key of Object.keys(values) as Array<keyof typeof values>) {
     const raw = input[key];
     const value = typeof raw === "string" ? raw.trim() : "";
@@ -57,10 +65,28 @@ export async function POST(request: Request) {
   }
   if (values.email && !inquiryEmail.test(values.email)) errors.email = "Enter a valid work email.";
   if (values.phase && !projectPhases.includes(values.phase)) errors.phase = "Select a project phase.";
+  if (values.how_did_you_hear_about_us && !leadSourceValues.includes(values.how_did_you_hear_about_us)) {
+    errors.how_did_you_hear_about_us = "Select how you heard about us.";
+  }
+
+  const otherRaw = typeof input.how_did_you_hear_about_us_other === "string" ? input.how_did_you_hear_about_us_other.trim() : "";
+  const other = values.how_did_you_hear_about_us === "other" ? otherRaw : "";
+  if (values.how_did_you_hear_about_us === "other") {
+    if (!other) errors.how_did_you_hear_about_us_other = "This field is required.";
+    else if (other.length > inquiryLimits.how_did_you_hear_about_us_other) {
+      errors.how_did_you_hear_about_us_other = `Use ${inquiryLimits.how_did_you_hear_about_us_other} characters or fewer.`;
+    }
+  }
+
   if (Object.keys(errors).length) {
     return Response.json({ error: "Review the highlighted fields.", fields: errors }, { status: 422 });
   }
 
+  const attribution = Object.fromEntries(
+    attributionFields.map((key) => [key, sanitizeAttribution(input[key], inquiryLimits[key])]),
+  );
+  const sourceLabel = leadSources.find((item) => item.value === values.how_did_you_hear_about_us)?.label ?? values.how_did_you_hear_about_us;
+
   const { RESEND_API_KEY, RESEND_FROM_EMAIL, PROJECT_INQUIRY_EMAIL } = process.env;
   if (!RESEND_API_KEY || !RESEND_FROM_EMAIL || !PROJECT_INQUIRY_EMAIL || !inquiryEmail.test(PROJECT_INQUIRY_EMAIL)) {
     return Response.json({ error: "Online inquiries are temporarily unavailable. Your inquiry was not sent." }, { status: 503 });
